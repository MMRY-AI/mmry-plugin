{
  "_comment": "Sample only. MMRY AI never applies this file. Copy the rules you want into your own Claude Code settings, review each one, and leave commands that delete files, force-push or read secrets out of the allow list. These rules check the command a member runs, not what a script or program does after it starts; allow a script only if you trust everything it does.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git diff --stat)",
      "Bash(git log)",
      "Bash(git log --oneline)",
      "Bash(git log -1)",
      "Bash(git show)",
      "Bash(git show --stat)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git add -A)",
      "Bash(git add -u)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(dotnet test)",
      "Bash(pytest)"
    ],
    "deny": [
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push*--mirror*)",
      "Bash(git *reset*--hard*)",
      "Bash(git *--output*)",
      "Bash(git *--no-index*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--exec*)",
      "Bash(git -c *)",
      "Bash(git * -c *)",
      "Bash(git *submodule foreach*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(*.secrets/*)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./**/.secrets/**)"
    ]
  }
}
