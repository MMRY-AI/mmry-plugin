#!/usr/bin/env bats
# release-files.bats - mmry/release-files.txt must list exactly what the release ships (#32957 fix
# round 4).
#
# self-update.sh removes from a customer's plugin folders every file this list does not name. A
# list that fell behind the tree would delete a file the release needs (a new handler nobody added
# to the list), and a list still naming a dropped file would leave it on every machine. So the list
# is generated by scripts/build-release-files.sh, and this fails whenever it is not current.

load '../helpers/test-helper'

REPO_ROOT=""

setup() {
    REPO_ROOT="$(cd "$PLUGIN_ROOT/.." && pwd)"
}

@test "release-files.txt matches the files git tracks under mmry/" {
    command -v git >/dev/null 2>&1 || fail "git is needed to compare the list with the tree"
    git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || fail "not a git checkout; run this suite from a clone of mmry-plugin"
    run bash "$REPO_ROOT/scripts/build-release-files.sh" --check
    [[ "$status" -eq 0 ]] || fail "$output"
}

@test "release-files.txt is for the version in plugin.json and marketplace.json" {
    local header listed plugin market
    IFS= read -r header < "$PLUGIN_ROOT/release-files.txt"
    listed="${header#\# mmry release files }"
    plugin="$(jq -r '.version' "$PLUGIN_ROOT/.claude-plugin/plugin.json")"
    market="$(jq -r '.plugins[0].version' "$REPO_ROOT/.claude-plugin/marketplace.json")"
    [[ "$listed" == "$plugin" ]] || fail "list is for $listed, plugin.json says $plugin"
    [[ "$listed" == "$market" ]] || fail "list is for $listed, marketplace.json says $market"
}

@test "release-files.txt names the files self-update trusts it by, and none of the old database scripts" {
    local f
    for f in release-files.txt hooks-handlers/self-update.sh .claude-plugin/plugin.json; do
        grep -Fxq -- "$f" "$PLUGIN_ROOT/release-files.txt" || fail "missing: $f"
    done
    for f in create-format.sh list-formats.sh query-records.sh record-history.sh revise-format.sh \
             rename-format.sh retire-format.sh reinstate-format.sh save-record.sh; do
        if grep -Fxq -- "hooks-handlers/$f" "$PLUGIN_ROOT/release-files.txt"; then
            fail "still listed: $f"
        fi
    done
}

@test "33033: the update documentation says files placed in the plugin's folders are removed, and where to keep them" {
    local doc
    for doc in "$REPO_ROOT/README.md" "$PLUGIN_ROOT/README.md"; do
        grep -Fq "any file you place inside one of them is removed when the plugin updates" "$doc" \
            || fail "$doc does not say a file placed in the plugin's folders is removed at update"
        grep -Fq "Keep your own scripts, notes and commands outside the plugin" "$doc" \
            || fail "$doc does not say where to keep your own files"
    done
}
