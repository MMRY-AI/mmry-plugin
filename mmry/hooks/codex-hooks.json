{
  "description": "MMRY AI lifecycle hooks for OpenAI Codex. Loads your memories at session start, re-states your Foundation memories each turn, delivers formation messages as you work, and prompts you to save when there is unsaved work.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" session-init",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" session-init",
            "statusMessage": "MMRY AI: loading your memories",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then exec sh \"$@\"; fi; done; exit 0' mmry-formation-gate \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" formation-check",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" formation-check",
            "statusMessage": "MMRY AI: checking for formation messages",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 1",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 1",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 2",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 2",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 3",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 3",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 4",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 4",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 5",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 5",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" userpromptsubmit-foundation --part 6",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" userpromptsubmit-foundation --part 6",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then exec sh \"$@\"; fi; done; exit 0' mmry-formation-gate \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" formation-check",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" formation-check",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" stop-check",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" stop-check",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then exec sh \"$@\"; fi; done; exit 0' mmry-formation-gate \"${PLUGIN_ROOT}/hooks-handlers/codex-hook.sh\" formation-check",
            "commandWindows": "cmd /d /c \"${PLUGIN_ROOT}\\hooks-handlers\\codex-hook.cmd\" formation-check",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
