{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-init.sh\"", 
            "timeout": 30
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then if [ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ]; then exec bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check; fi; exit 0; fi; done; exit 0'", 
            "timeout": 15
          }
        ]
      }
    ], 
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 1", 
            "timeout": 20
          }, 
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 2", 
            "timeout": 20
          }, 
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 3", 
            "timeout": 20
          }, 
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 4", 
            "timeout": 20
          }, 
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 5", 
            "timeout": 20
          }, 
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\" --part 6", 
            "timeout": 20
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then if [ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ]; then exec bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check; fi; exit 0; fi; done; exit 0'", 
            "timeout": 15
          }
        ]
      }
    ], 
    "Stop": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh stop-check || true\"", 
            "timeout": 10
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then if [ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ]; then exec bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check; fi; exit 0; fi; done; exit 0'", 
            "asyncRewake": true, 
            "rewakeSummary": "MMRY formation", 
            "timeout": 1800
          }
        ]
      }
    ], 
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh precompact-check || true\"", 
            "timeout": 10
          }
        ]
      }
    ], 
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode", 
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh plan-accepted-check || true\"", 
            "timeout": 10
          }
        ]
      }, 
      {
        "hooks": [
          {
            "command": "sh -c 'for f in \"${TMPDIR:-/tmp}\"/.mmry-formation-*; do if [ -f \"$f\" ]; then if [ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ]; then exec bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check; fi; exit 0; fi; done; exit 0'", 
            "type": "command", 
            "timeout": 15
          }
        ]
      }
    ]
  }
}
