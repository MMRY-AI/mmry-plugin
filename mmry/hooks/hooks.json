{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-init.sh\"", 
            "timeout": 30
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/formation-check.sh ] || exit 0; bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check\"", 
            "timeout": 15
          }
        ]
      }
    ], 
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/userpromptsubmit-foundation.sh\"", 
            "timeout": 5
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/formation-check.sh ] || exit 0; bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check\"", 
            "timeout": 10
          }
        ]
      }
    ], 
    "Stop": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh stop-check || true\"", 
            "timeout": 10
          }
        ]
      }, 
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/formation-check.sh ] || exit 0; bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check\"", 
            "asyncRewake": true, 
            "rewakeSummary": "Formation transmission", 
            "timeout": 300
          }
        ]
      }
    ], 
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh precompact-check || true\"", 
            "timeout": 10
          }
        ]
      }
    ], 
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode", 
        "hooks": [
          {
            "type": "command", 
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/hook-guard.sh ] && bash ~/.claude/mmry/hooks-handlers/hook-guard.sh plan-accepted-check || true\"", 
            "timeout": 10
          }
        ]
      }, 
      {
        "hooks": [
          {
            "command": "bash -c \"[ -f ~/.claude/mmry/hooks-handlers/formation-check.sh ] || exit 0; bash ~/.claude/mmry/hooks-handlers/hook-guard.sh formation-check\"", 
            "type": "command", 
            "timeout": 8
          }
        ]
      }
    ]
  }
}
